# Copy to .env for local development (never commit .env).

# Keep this stable: vault encryption keys are derived from it.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Firebase console -> Project settings -> Your apps -> Web app (public config, one line of JSON)
FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"YOUR_PROJECT.firebaseapp.com","projectId":"YOUR_PROJECT","appId":"..."}

# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Use ONE of these (on Vercel use the JSON variable):
FIREBASE_SERVICE_ACCOUNT_FILE=serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Offline UI work only (needs DEBUG): CYM_BACKEND=memory
